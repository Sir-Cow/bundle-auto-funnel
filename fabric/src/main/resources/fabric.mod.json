{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/bundle-auto-funnel",
        "sources": "https://github.com/Sir-Cow/bundle-auto-funnel",
        "issues": "https://github.com/Sir-Cow/bundle-auto-funnel/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "sircow.bundleautofunnel.FabricBundleAutoFunnel"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.modrinth": "https://modrinth.com/mod/bundle-auto-funnel",
                "modmenu.curseforge": "https://curseforge.com/minecraft/mc-mods/bundle-auto-funnel"
            },
            "update_checker": true
        }
    }
}